{
  "default": true,
  "heading-increment": true,
  "no-hard-tabs": true,
  "no-trailing-spaces": true,
  "no-multiple-blanks": {
    "maximum": 1
  },
  "line-length": {
    "line_length": 120,
    "heading_line_length": 120,
    "headers": false,
    "code_blocks": false,
    "code_fence": false,
    "tables": false
  },
  "no-missing-space-atx": true,
  "no-space-in-emphasis": true,
  "no-space-in-code": true,
  "blanks-around-headings": {
    "lines_above": 1,
    "lines_below": 1
  },
  "blanks-around-lists": true,
  "no-duplicate-heading": {
    "siblings_only": true
  },
  "no-trailing-punctuation": {
    "punctuation": ".,;:!?"
  },
  "no-multiple-spaces": true,
  "list-marker-space": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  },
  "list-indent": true,
  "code-block-style": {
    "style": "fenced"
  },
  "code-fence-style": {
    "style": "backtick"
  },
  "fenced-code-language": true,
  "first-line-h1": false,
  "first-list-item-h1": false,
  "no-inline-html": false,
  "no-bare-urls": true,
  "no-emphasis-as-heading": true,
  "proper-names": false,
  "no-alt-text": false,
  "link-fragments": true,
  "ul-style": {
    "style": "-"
  },
  "ul-indent": {
    "indent": 2
  },
  "ol-prefix": {
    "style": "ordered"
  }
}
